{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // Secrets are NOT stored here. Provide them per environment:
  //   dev  : dotnet user-secrets set "Jwt:Key" "<key>"
  //          dotnet user-secrets set "ConnectionStrings:default" "<connection string>"
  //   prod : environment variables Jwt__Key and ConnectionStrings__default
  "ConnectionStrings": {
    "default": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "DriviousAPI",
    "Audience": "DriviousClient",
    "ExpireDays": 7
  }
}
