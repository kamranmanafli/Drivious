{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // Front end origins allowed to call this API. Add the deployed origin here
  // before publishing; an origin missing from this list is blocked by the browser.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:4200",
      "https://localhost:5173"
    ]
  },

  // Secrets are NOT stored here. Provide them per environment:
  //   dev  : dotnet user-secrets set "Jwt:Key" "<key>"
  //          dotnet user-secrets set "ConnectionStrings:default" "<connection string>"
  //   prod : environment variables Jwt__Key and ConnectionStrings__default
  "ConnectionStrings": {
    "default": ""
  },

  // How the expiry scan behaves. LeadDays is both how far ahead a date is warned
  // about and how far back an already passed one is still reported.
  "Notifications": {
    "LeadDays": 30,
    "ScanIntervalHours": 12,
    "Enabled": true
  },

  "Jwt": {
    "Key": "",
    "Issuer": "DriviousAPI",
    "Audience": "DriviousClient",
    "ExpireDays": 7
  }
}
