# Copy to .env and adjust. No secrets belong here — a VITE_ variable is baked
# into the browser bundle and is therefore public.

# Origin of the ASP.NET API. The "http" launch profile serves it on port 5221.
# If you change the port, add the new origin to Cors:AllowedOrigins in
# appsettings.json as well, or the browser blocks every request.
VITE_API_URL=http://localhost:5221
