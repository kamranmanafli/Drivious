# Local development defaults. No secrets belong in this file — everything a
# VITE_ variable holds is baked into the browser bundle and is therefore public.

# Origin of the ASP.NET API. Matches the "http" profile in
# Properties/launchSettings.json, which is what `dotnet run` starts by default.
# Change it and the new origin has to be added to Cors:AllowedOrigins in
# appsettings.json as well, or the browser blocks every request.
VITE_API_URL=http://localhost:5221
